# ═══════════════════════════════════════════════
#   HunarLink — .gitignore
#   NEVER commit API keys, secrets, or build files
# ═══════════════════════════════════════════════

# ─── API Keys & Secrets — CRITICAL ─────────────
agent/.env
agent/.env.*
**/.env
**/.env.*
**/*.env
**/config.secret.json
**/google_maps_api_key*
**/secrets.*
**/*secret*
**/*apikey*
**/*api_key*

# ─── Firebase Service Account ───────────────────
agent/serviceAccountKey.json
agent/serviceAccountKey*
**/serviceAccountKey*
mobile/lib/firebase_options.dart
mobile/android/app/google-services.json
mobile/ios/GoogleService-Info.plist
mobile/ios/Runner/GoogleService-Info.plist

# ─── Node.js ───────────────────────────────────
agent/node_modules/
agent/package-lock.json
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Flutter / Dart ────────────────────────────
mobile/.dart_tool/
mobile/build/
mobile/*.g.dart
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/pubspec.lock
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug.keystore
mobile/android/app/release.keystore
mobile/ios/.symlinks/
mobile/ios/Pods/
mobile/ios/Podfile.lock
**/*.iml

# ─── Trace Logs (optional — uncomment to exclude) ─
# agent/trace_logs/

# ─── OS Generated ──────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.log

# ─── Build Artifacts ───────────────────────────
dist/
build/
*.apk
*.aab
*.ipa
